# PanelRx — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored by default in Vite projects.

# Anthropic API key for live Claude calls in /reconcile
# Get one at https://console.anthropic.com/
# IMPORTANT: This key gets bundled into the browser build.
# For the hackathon this is acceptable. Rotate the key after the event.
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default models used by agents
# VITE_DEFAULT_MODEL_SONNET=claude-sonnet-4-6
# VITE_DEFAULT_MODEL_HAIKU=claude-haiku-4-5
